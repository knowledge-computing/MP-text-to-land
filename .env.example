# Copy this file to .env and fill in local paths. .env is git-ignored.
# Path values are joined by plain string concatenation, so keep the trailing "/".

# Folder containing <county-folder>/*.geojson
GEOJSON_PATH=/path/to/geojson/
# Folder containing <county-folder>/<image_id>.txt OCR results
OCRTXT_PATH=/path/to/covenants-deed-images/ocr/txt/
# (optional) S3 prefix for the same OCR txt files, used to build aws s3 cp commands
S3_PATH=s3://your-bucket/ocr/txt/

# County folder names as a comma-separated string, no spaces (required: `import src` fails without it)
FOLDER_NAMES=mn-anoka-county,mn-dakota-county,mn-olmsted-county,mn-sherburne-county,mn-washington-county,wi-milwaukee-county
