# Copy this file to .env and fill in local paths. .env is git-ignored. Placeholders only.
# Path values are joined by plain string concatenation, so keep the trailing "/".

# Folder containing <county-folder>/*.geojson
GEOJSON_PATH=/path/to/geojson/
# Folder containing <county-folder>/<image_id>.txt OCR results
OCRTXT_PATH=/path/to/<ocr-root>/ocr/txt/
# (optional) S3 prefix for the same OCR txt files, used to build aws s3 cp commands
S3_PATH=s3://your-bucket/ocr/txt/

# County folder names as a comma-separated string, no spaces (required: `import src` fails without it)
FOLDER_NAMES=mn-anoka-county,mn-dakota-county,mn-olmsted-county,mn-sherburne-county,mn-washington-county,wi-milwaukee-county

# --- Private data locations for dev/ scripts (dev/private_paths.py). No built-in defaults.
# Root of the private data folder (absolute)
MP_DATA_ROOT=/path/to/private-data-root
# 2025 run folder (splits, PLSS layers, try08 model and outputs); absolute or relative to MP_DATA_ROOT
MP_RUN_DIR=<run-dir>
# Local OCR root (its folder name must match the folder name inside the remote saved_path values);
# absolute or relative to MP_DATA_ROOT
MP_OCR_ROOT=<ocr-root>
# Local JSON describing the partner plat layers (copy plat_config.example.json; keep it out of git)
MP_PLAT_CONFIG=/path/to/plat_config.json

# --- src/training/subdivision_ner_training.py
MP_NER_TRAIN_FILE=/path/to/train.jsonl
MP_NER_DEV_FILE=/path/to/dev.jsonl
MP_NER_OUTPUT_DIR=/path/to/model_output
